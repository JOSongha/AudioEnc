experiments/audio_encoder_probe/embeds_layers/
experiments/audio_encoder_probe/embeds_layers_smoke/
experiments/representation_richness/

# large model weights not covered by wildcard rules above
external/models/Qwen3.5AE-4B-wavtok-75-speech/*.safetensors
external/models/Qwen3.5AE-4B-wavtok-75-speech/model.safetensors.index.json

# local backup / temp downloads
_local_backup/
data/_downloads_tmp/

# Crash dumps from training failures
core.*

# Stage-1 v5 projL model dirs: only config.json is owned; the rest are
# symlinks to the base dir's weights/code, recreated by
# scripts/setup_v5_projL_models.sh.
external/models/Qwen3.5AE-4B-*-projL/*
!external/models/Qwen3.5AE-4B-*-projL/config.json
external/models/Qwen3.5AE-4B-projL/*
!external/models/Qwen3.5AE-4B-projL/config.json
